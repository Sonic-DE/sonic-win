@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(SonicIpc)

# Header-only: the protocol between sonic-win's dwell clicker and its panel applet.
if(NOT TARGET SonicWin::DwellClickerIpc)
    add_library(SonicWin::DwellClickerIpc INTERFACE IMPORTED)
    set_target_properties(SonicWin::DwellClickerIpc PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "@PACKAGE_KDE_INSTALL_INCLUDEDIR@/SonicWin"
        INTERFACE_LINK_LIBRARIES Sonic::Ipc
    )
endif()
