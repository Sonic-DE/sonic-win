msgctxt "@label:listbox"
msgid "Application menu button style:"
msgstr "Ìng-iōng thîng-sik suán-tuann liú-á ê khuán-sik:"

msgctxt "@item:inlistbox application menu button style"
msgid "Single menu button"
msgstr "Tan-it suán-tuann liú-á"

msgctxt "@item:inlistbox application menu button style"
msgid "Always shown"
msgstr "It-ti̍t hián-sī"

msgctxt "@item:inlistbox application menu button style"
msgid "Shown on hover"
msgstr "Tshí-tháu khǹg tíng-kuân tsiah hián-sī"

msgctxt "checkbox label"
msgid "Show a search button with the application menu"
msgstr "Tī ìng-iōng thîng-sik suán-tuann pinn-á hián-sī tshuē ê liú-á"

msgctxt "@info"
msgid "The selected window decoration style shows the application menu as a single button."
msgstr "Só͘ kíng ê thang-á tsong-sik khuán-sik kā ìng-iōng thîng-sik suán-tuann hián-sī tsò tan-it ê liú-á."

msgctxt "@info"
msgid "Add the Application menu button to the titlebar to use these options."
msgstr "Nā beh iōng tsia-ê suán-hāng, tshiánn kā ìng-iōng thîng-sik suán-tuann liú-á ka-ji̍p khì phiau-tê-lia̍t."
