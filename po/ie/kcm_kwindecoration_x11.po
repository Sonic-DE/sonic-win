msgctxt "@label:listbox"
msgid "Application menu button style:"
msgstr "Stil del buton del menú de application:"

msgctxt "@item:inlistbox application menu button style"
msgid "Single menu button"
msgstr "Un singul buton de menú"

msgctxt "@item:inlistbox application menu button style"
msgid "Always shown"
msgstr "Sempre monstrat"

msgctxt "@item:inlistbox application menu button style"
msgid "Shown on hover"
msgstr "Monstrat al passar"

msgctxt "checkbox label"
msgid "Show a search button with the application menu"
msgstr "Monstrar un buton de sercha con li menú de application"

msgctxt "@info"
msgid "The selected window decoration style shows the application menu as a single button."
msgstr "Li selectet stil de decoration de fenestres monstra li menú de application quam un singul buton."

msgctxt "@info"
msgid "Add the Application menu button to the titlebar to use these options."
msgstr "Adjunte li buton del menú de application al barre de titul por usar ti optiones."
