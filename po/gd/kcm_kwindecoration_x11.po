msgctxt "@label:listbox"
msgid "Application menu button style:"
msgstr "Stoidhle putan clàr-taice na h-aplacaid:"

msgctxt "@item:inlistbox application menu button style"
msgid "Single menu button"
msgstr "Aon phutan clàr-taice"

msgctxt "@item:inlistbox application menu button style"
msgid "Always shown"
msgstr "Ga shealltainn an-còmhnaidh"

msgctxt "@item:inlistbox application menu button style"
msgid "Shown on hover"
msgstr "Ga shealltainn le fantainn os a chionn"

msgctxt "checkbox label"
msgid "Show a search button with the application menu"
msgstr "Seall putan luirg le clàr-taice na h-aplacaid"

msgctxt "@info"
msgid "The selected window decoration style shows the application menu as a single button."
msgstr "Seallaidh an stoidhle sgeadachaidh uinneige a thagh thu clàr-taice na h-aplacaid mar aon phutan."

msgctxt "@info"
msgid "Add the Application menu button to the titlebar to use these options."
msgstr "Cuir putan clàr-taice na h-aplacaid ris a’ bhàr-tiotail airson na roghainnean seo a chleachdadh."
