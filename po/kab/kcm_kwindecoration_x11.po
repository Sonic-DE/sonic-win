msgctxt "@label:listbox"
msgid "Application menu button style:"
msgstr "Aɣanib n tqeffalt n wumuɣ n usnas:"

msgctxt "@item:inlistbox application menu button style"
msgid "Single menu button"
msgstr "Taqeffalt n wumuɣ tasuft"

msgctxt "@item:inlistbox application menu button style"
msgid "Always shown"
msgstr "Yettwaskan yal tikkelt"

msgctxt "@item:inlistbox application menu button style"
msgid "Shown on hover"
msgstr "Yettwaskan mi ara tɛeddiḍ fell-as"

msgctxt "checkbox label"
msgid "Show a search button with the application menu"
msgstr "Sken taqeffalt n unadi akked wumuɣ n usnas"

msgctxt "@info"
msgid "The selected window decoration style shows the application menu as a single button."
msgstr "Aɣanib n ucebbeḥ n usfaylu yettwafernen yesskan umuɣ n usnas am tqeffalt tasuft."

msgctxt "@info"
msgid "Add the Application menu button to the titlebar to use these options."
msgstr "Rnu taqeffalt n wumuɣ n usnas ɣer ufeggag n uzwel akken ad tesqedceḍ tixtiṛiyin-a."
