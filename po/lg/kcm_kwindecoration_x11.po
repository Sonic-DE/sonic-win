msgctxt "@label:listbox"
msgid "Application menu button style:"
msgstr "Engeri y'eppeesa ya menu ya pulogulaamu:"

msgctxt "@item:inlistbox application menu button style"
msgid "Single menu button"
msgstr "Eppeesa ya menu emu"

msgctxt "@item:inlistbox application menu button style"
msgid "Always shown"
msgstr "Erabika bulijjo"

msgctxt "@item:inlistbox application menu button style"
msgid "Shown on hover"
msgstr "Erabika ng'okutteeko akasongezo"

msgctxt "checkbox label"
msgid "Show a search button with the application menu"
msgstr "Laga eppeesa ly'okunoonya wamu ne menu ya pulogulaamu"

msgctxt "@info"
msgid "The selected window decoration style shows the application menu as a single button."
msgstr "Engeri y'okuyooyoota amadirisa gy'olonze eraga menu ya pulogulaamu ng'eppeesa limu."

msgctxt "@info"
msgid "Add the Application menu button to the titlebar to use these options."
msgstr "Gattako eppeesa lya menu ya pulogulaamu ku bbaala y'omutwe okukozesa ebyo by'oyinza okulondako."
