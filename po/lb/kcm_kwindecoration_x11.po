msgctxt "@label:listbox"
msgid "Application menu button style:"
msgstr "Stil vum Applikatiounsmenü-Knäppchen:"

msgctxt "@item:inlistbox application menu button style"
msgid "Single menu button"
msgstr "Een eenzelne Menüknäppchen"

msgctxt "@item:inlistbox application menu button style"
msgid "Always shown"
msgstr "Ëmmer ugewisen"

msgctxt "@item:inlistbox application menu button style"
msgid "Shown on hover"
msgstr "Beim Driwwerfueren ugewisen"

msgctxt "checkbox label"
msgid "Show a search button with the application menu"
msgstr "E Sichknäppchen beim Applikatiounsmenü uweisen"

msgctxt "@info"
msgid "The selected window decoration style shows the application menu as a single button."
msgstr "Den ausgewielte Fensterdekoratiounsstil weist den Applikatiounsmenü als eenzelne Knäppchen."

msgctxt "@info"
msgid "Add the Application menu button to the titlebar to use these options."
msgstr "Füügt de Applikatiounsmenü-Knäppchen an d'Titelleescht bäi, fir dës Optiounen ze benotzen."
