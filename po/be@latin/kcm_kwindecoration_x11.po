msgctxt "@label:listbox"
msgid "Application menu button style:"
msgstr "Styl knopki mieniu prahramy:"

msgctxt "@item:inlistbox application menu button style"
msgid "Single menu button"
msgstr "Adna knopka mieniu"

msgctxt "@item:inlistbox application menu button style"
msgid "Always shown"
msgstr "Pakazvajecca zaŭsiody"

msgctxt "@item:inlistbox application menu button style"
msgid "Shown on hover"
msgstr "Pakazvajecca pry naviadzienni"

msgctxt "checkbox label"
msgid "Show a search button with the application menu"
msgstr "Pakazvać knopku pošuku razam z mieniu prahramy"

msgctxt "@info"
msgid "The selected window decoration style shows the application menu as a single button."
msgstr "Vybrany styl upryhožvannia akon pakazvaje mieniu prahramy jak adnu knopku."

msgctxt "@info"
msgid "Add the Application menu button to the titlebar to use these options."
msgstr "Dadajcie knopku mieniu prahramy na paneĺ zahaloŭka, kab vykarystoŭvać hetyja parametry."
