msgctxt "@label:listbox"
msgid "Application menu button style:"
msgstr "Հավելվածի ընտրացանկի կոճակի ոճը:"

msgctxt "@item:inlistbox application menu button style"
msgid "Single menu button"
msgstr "Մեկ ընտրացանկի կոճակ"

msgctxt "@item:inlistbox application menu button style"
msgid "Always shown"
msgstr "Միշտ ցուցադրված"

msgctxt "@item:inlistbox application menu button style"
msgid "Shown on hover"
msgstr "Ցուցադրված սավառնելիս"

msgctxt "checkbox label"
msgid "Show a search button with the application menu"
msgstr "Ցուցադրել որոնման կոճակ հավելվածի ընտրացանկի հետ"

msgctxt "@info"
msgid "The selected window decoration style shows the application menu as a single button."
msgstr "Ընտրված պատուհանի զարդարման ոճը հավելվածի ընտրացանկը ցուցադրում է որպես մեկ կոճակ:"

msgctxt "@info"
msgid "Add the Application menu button to the titlebar to use these options."
msgstr "Ավելացրեք հավելվածի ընտրացանկի կոճակը վերնագրի գոտուն՝ այս ընտրանքներն օգտագործելու համար:"
